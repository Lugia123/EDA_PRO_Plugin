{
	"name": "eda-bridge",
	"type": "module",
	"version": "0.1.15",
	"description": "立创EDA专业版扩展：连接本机 eda-mcp，在 EDA 内执行 AI 下发的代码。派生自 easyeda/pro-api-sdk 脚手架。",
	"author": "EDA_PRO_Plugin contributors",
	"license": "Apache-2.0",
	"homepage": "",
	"bin": {
		"create-easyeda-api-sdk": "./build/create.js"
	},
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"prebuild": "node ../scripts/stamp-version.mjs",
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && ts-node ./build/packaged.ts",
		"debug": "ts-node ./build/dev.ts",
		"update:check": "ts-node ./build/update.ts check",
		"update": "ts-node ./build/update.ts update && npm install",
		"manifest:generate": "npm install && ts-node ./build/manifest.ts generate",
		"manifest:bump": "npm install && ts-node ./build/manifest.ts bump && npm install"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.3.13",
		"@types/fs-extra": "^11.0.4",
		"@types/ws": "^8.5.13",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"lint-staged": "^16.2.3",
		"rimraf": "^6.0.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3",
		"ws": "^8.18.0"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	},
	"private": true
}
