{
  "name": "eda-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "立创EDA专业版 本地 MCP Server —— 内置 bridge（WebSocket）与 EDA 扩展通信，esbuild bundle 后随 Claude Code plugin 分发（不走 npm registry）",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && bash scripts/deploy-to-plugin.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
